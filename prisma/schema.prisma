generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT
  OTHER
}

model Bill {
  id            String        @id @default(cuid())
  partyId       String?
  partyName     String
  billNumber    String
  billDate      DateTime
  billAmount    Decimal       @db.Decimal(12, 2)
  billImageUrl  String?
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMode   PaymentMode   @default(CREDIT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  party         Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([partyId])
  @@index([partyName])
  @@index([billNumber])
  @@index([billDate])
}

model Party {
  id        String   @id @default(cuid())
  partyCode String   @unique
  partyName String
  location  String
  phone     String?
  gstNumber String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]

  @@index([partyName])
  @@index([location])
}
